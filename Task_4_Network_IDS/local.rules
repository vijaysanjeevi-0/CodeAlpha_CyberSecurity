# Custom Snort Intrusion Detection Rules
# Location: /etc/snort/rules/local.rules

# Rule 1: Detect ICMP echo request traffic (Ping scan)
alert icmp any any -> any any (msg:"[SECURITY ALERT] ICMP Echo Ping Scan Detected"; sid:1000001; rev:1;)

# Rule 2: Detect unauthorized TCP connection attempts on common SSH port 22
alert tcp any any -> any 22 (msg:"[SECURITY ALERT] Inbound SSH Connection Attempt"; flags:S; sid:1000002; rev:1;)
